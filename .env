# Everything prefixed with VITE_ is PUBLIC (bundled into the browser). Never put secrets here.

# true  = static mock data from src/data (Phase 1 demo)
# false = Laravel API at VITE_API_URL (Phase 2)
VITE_USE_MOCK=true
VITE_API_URL=http://localhost:8000/api/v1

# Public site URL, used for canonical links and Open Graph tags
VITE_SITE_URL=https://buildora-demo.vercel.app

# Contact details shown on the site. Use GrowX's own number for the demo so
# calls and WhatsApp messages reach us. Leave empty to show a placeholder
# with the call/WhatsApp links disabled.
# Format: digits only with country code, e.g. 8801XXXXXXXXX
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=

# Web3Forms public access key (https://web3forms.com). Restrict it to our
# domain in the Web3Forms dashboard. Leave empty to simulate form success.
VITE_WEB3FORMS_KEY=
